{
    "name": "taoti/yoimages",
    "description": "Taoti's maintained fork of YoImages: image cropping, image SEO hooks, and stock photo search for WordPress, in one package. PHP 8.4 compatible.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "homepage": "https://github.com/Taoti/yoimages",
    "keywords": ["wordpress", "plugin", "images", "crop", "seo"],
    "authors": [
        {
            "name": "Sirulli",
            "homepage": "http://sirulli.org/"
        },
        {
            "name": "Taoti Creative",
            "homepage": "https://taoti.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "composer/installers": "^2.0"
    },
    "replace": {
        "sirulli/yoimages": "*"
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^3.13",
        "wp-coding-standards/wpcs": "^3.3",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "phpcompatibility/phpcompatibility-wp": "^2.1"
    },
    "scripts": {
        "lint": [
            "@lint:syntax",
            "@lint:compat"
        ],
        "lint:syntax": "find yoimages.php src -name '*.php' -print0 | xargs -0 -n1 php -l > /dev/null",
        "lint:compat": "phpcs --standard=PHPCompatibilityWP --runtime-set testVersion 8.1- --extensions=php yoimages.php src",
        "lint:wpcs": "phpcs --standard=phpcs.xml.dist yoimages.php src"
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
